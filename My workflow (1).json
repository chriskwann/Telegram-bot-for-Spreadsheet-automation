    {
      "parameters": {
        "jsCode": "//CONFIG: column names\nconst COL_COMPANY     = 'Company Name';\nconst COL_TOTALSPENT  = 'Total Spent (RM)';\nconst COL_INDUSTRY    = 'Industry';\nconst COL_YEARS       = 'Years in Operation';\nconst COL_STAFF       = 'Total Staff';\n\n//INPUT\nconst rows     = items.map(i => i.json);\nconst question = $node[\"Telegram Trigger\"].json.message.text.toLowerCase();\nconst chatId   = $node[\"Telegram Trigger\"].json.message.chat.id;\n\nconst toNum = (v) => Number(String(v).replace(/,/g, '') || 0);\n\n//CASE A for Which company spent the most?\nif (question.includes(\"spent the most\")) {\n\n  let maxRow = rows[0];\n  for (const r of rows) {\n    if (toNum(r[COL_TOTALSPENT]) > toNum(maxRow[COL_TOTALSPENT])) {\n      maxRow = r;\n    }\n  }\n\n  return [{\n    json: {\n      action: \"reply\",\n      reply: `The company that spent the most is ${maxRow[COL_COMPANY]} with RM ${maxRow[COL_TOTALSPENT]}.`,\n      chatId\n    }\n  }];\n}\n\n\n//Case B for What's the average total spent?\nif (question.includes(\"average\") && question.includes(\"total\")) {\n\n  const nums = rows.map(r => toNum(r[COL_TOTALSPENT]));\n  const avg  = nums.reduce((a, b) => a + b, 0) / nums.length;\n\n  return [{\n    json: {\n      action: \"reply\",\n      reply: `The average total spent is RM ${avg.toFixed(2)}.`,\n      chatId\n    }\n  }];\n}\n\n//CaseD to update bailey operation year\nif (\n  question.includes(\"update\") &&\n  question.includes(\"bailey\") &&\n  question.includes(\"years\")\n) {\n    // find exact company name\n    let company = null;\n    for (let row of rows) {\n        if (String(row[COL_COMPANY]).toLowerCase().includes(\"bailey\")) {\n            company = row[COL_COMPANY];\n            break;\n        }\n    }\n\n    if (!company) {\n        return [{\n          json: { action: \"reply\", reply: \"Bailey Ltd was not found.\", chatId }\n        }];\n    }\n\n    return [{\n        json: {\n            action: \"update-bailey\",\n            company,                 // We update by company name\n            newValues: { [COL_YEARS]: \"20\" },\n            reply: \"Bailey Ltd has been updated to 20 years.\",\n            chatId\n        }\n    }];\n}\n\n\n\n//CaseE to update staff number more than 100 to 200\nif (\n  question.includes(\"update\") &&\n  question.includes(\"staff\") &&\n  question.includes(\"100\")\n) {\n\n  let updates = [];\n\n  // Build update list\n  for (let i = 0; i < rows.length; i++) {\n    const staff = toNum(rows[i][COL_STAFF]);\n    if (staff > 100) {\n      updates.push({\n        row_number: i + 2,\n        newValues: { [COL_STAFF]: \"200\" }\n      });\n    }\n  }\n\n  if (updates.length === 0) {\n    reply = \"No companies have more than 100 staff.\";\n    return [{ json: { action: \"reply\", reply, chatId } }];\n  }\n\n  // RETURN ONLY ONE ITEM\n  return [{\n    json: {\n      action: \"update-staff\",\n      updates,     // array of updates sent as ONE item\n      reply: `Updated ${updates.length} companies to 200 staff.`,\n      chatId\n    }\n  }];\n}\n\n//caseC to find out how many comapnies in a single category and their total spend\nconst industries = [\n    \"construction\",\"technology\",\"healthcare\",\"hospitality\",\"education\",\n    \"energy\",\"finance\",\"retail\",\"manufacturing\",\"transportation\"\n];\n\nlet industry = industries.find(i => question.includes(i));\n\nif (industry) {\n    const filtered = rows.filter(r =>\n        String(r[COL_INDUSTRY]).toLowerCase() === industry\n    );\n    const count = filtered.length;\n    const total = filtered.reduce((a,r)=>a+toNum(r[COL_TOTALSPENT]),0);\n\n    return [{\n      json: {\n        action: \"reply\",\n        reply: `There are ${count} ${industry} companies with total spend RM ${total.toFixed(2)}.`,\n        chatId\n      }\n    }];\n}\n\n//output for default function\nreturn {\n  json: {\n    action: \"update-bailey\",\n    company: \"Bailey Ltd\",\n    newValues: { \"Years in Operation\": \"20\" },\n    reply: \"Bailey Ltd has been updated to 20 years.\",\n    chatId\n  }\n};\n\n"
      },
